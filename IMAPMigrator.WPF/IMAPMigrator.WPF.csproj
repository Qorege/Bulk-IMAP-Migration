<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>IMAPMigrator.WPF</RootNamespace>
    <AssemblyName>IMAPMigrator.WPF</AssemblyName>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8632;SYSLIB0039</NoWarn>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\ImapModels.cs" Link="Core\ImapModels.cs" />
    <Compile Include="..\src\ImapClient.cs" Link="Core\ImapClient.cs" />
    <Compile Include="..\src\ImapStream.cs" Link="Core\ImapStream.cs" />
    <Compile Include="..\src\MigrationEngine.cs" Link="Core\MigrationEngine.cs" />
    <Compile Include="..\src\MigrationJournal.cs" Link="Core\MigrationJournal.cs" />
    <Compile Include="..\src\CsvHandler.cs" Link="Core\CsvHandler.cs" />
    <Compile Include="..\src\MockImapServer.cs" Link="Core\MockImapServer.cs" />
    <Compile Include="..\src\Settings.cs" Link="Core\Settings.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\app.ico" Link="app.ico" />
    <Resource Include="..\icon.png" Link="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
