<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- M3 Type Scale — Google Sans / Segoe UI fallback -->
    <FontFamily x:Key="M3.Font.Brand">Segoe UI Variable, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="M3.Font.Plain">Segoe UI, Arial</FontFamily>

    <!-- Display -->
    <Style x:Key="M3.Text.DisplayLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Brand}" />
        <Setter Property="FontSize" Value="57" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="64" />
    </Style>

    <Style x:Key="M3.Text.DisplayMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Brand}" />
        <Setter Property="FontSize" Value="45" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="52" />
    </Style>

    <!-- Headline -->
    <Style x:Key="M3.Text.HeadlineLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Brand}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="40" />
    </Style>

    <Style x:Key="M3.Text.HeadlineMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Brand}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="36" />
    </Style>

    <Style x:Key="M3.Text.HeadlineSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Brand}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <!-- Title -->
    <Style x:Key="M3.Text.TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Brand}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style x:Key="M3.Text.TitleMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="M3.Text.TitleSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- Label -->
    <Style x:Key="M3.Text.LabelLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="M3.Text.LabelMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="M3.Text.LabelSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <!-- Body -->
    <Style x:Key="M3.Text.BodyLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="M3.Text.BodyMedium" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="M3.Text.BodySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

</ResourceDictionary>
