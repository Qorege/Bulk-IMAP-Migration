<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 FILLED BUTTON                                -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.Button.Filled" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource M3.Brush.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource M3.Shape.ExtraLarge}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- M3 FILLED TONAL BUTTON -->
    <Style x:Key="M3.Button.FilledTonal" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource M3.Brush.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSecondaryContainer}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource M3.Shape.ExtraLarge}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- M3 OUTLINED BUTTON -->
    <Style x:Key="M3.Button.Outlined" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource M3.Brush.Outline}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource M3.Shape.ExtraLarge}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource M3.Brush.SurfaceContainerLow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource M3.Brush.SurfaceContainer}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- M3 TEXT BUTTON -->
    <Style x:Key="M3.Button.Text" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource M3.Shape.ExtraLarge}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource M3.Brush.SurfaceContainerLow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource M3.Brush.SurfaceContainer}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- M3 ERROR FILLED BUTTON -->
    <Style x:Key="M3.Button.Error" TargetType="Button" BasedOn="{StaticResource M3.Button.Filled}">
        <Setter Property="Background" Value="{StaticResource M3.Brush.Error}" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnError}" />
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 OUTLINED TEXT FIELD                          -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.TextBox.Outlined" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource M3.Brush.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource M3.Brush.PrimaryContainer}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource M3.Brush.Outline}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3.Shape.ExtraSmall}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource M3.Brush.OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource M3.Brush.Primary}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- M3 PASSWORD BOX -->
    <Style x:Key="M3.PasswordBox.Outlined" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource M3.Brush.Primary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource M3.Brush.PrimaryContainer}" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource M3.Brush.Outline}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource M3.Shape.ExtraSmall}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource M3.Brush.OnSurface}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource M3.Brush.Primary}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 COMBOBOX                                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource M3.Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="MinHeight" Value="48" />
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 TAB CONTROL                                  -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.TabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="M3.TabItem" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurfaceVariant}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <Border x:Name="Indicator"
                                Height="3"
                                VerticalAlignment="Bottom"
                                CornerRadius="2,2,0,0"
                                Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource M3.Brush.Primary}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource M3.Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource M3.Brush.SurfaceContainerLow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 PROGRESS BAR                                 -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource M3.Brush.SurfaceContainerHighest}" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.Primary}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 CARD (Surface Container)                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.Card.Outlined" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource M3.Brush.SurfaceContainerLowest}" />
        <Setter Property="BorderBrush" Value="{StaticResource M3.Brush.OutlineVariant}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource M3.Shape.Medium}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="M3.Card.Filled" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource M3.Brush.SurfaceContainerHigh}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource M3.Shape.Medium}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 CHECKBOX                                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.CheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 DATAGRID                                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource M3.Brush.OutlineVariant}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource M3.Brush.SurfaceContainerLow}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="48" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- M3 LISTBOX                                      -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
    </Style>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- WINDOW BASE                                     -->
    <!-- ═══════════════════════════════════════════════ -->
    <Style x:Key="M3.Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource M3.Brush.Surface}" />
        <Setter Property="FontFamily" Value="{StaticResource M3.Font.Plain}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource M3.Brush.OnSurface}" />
    </Style>

</ResourceDictionary>
