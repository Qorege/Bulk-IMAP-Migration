<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material Design 3 Semantic Color Tokens — Teal/Cyan palette -->
    <!-- Primary -->
    <Color x:Key="M3.Primary">#006A6A</Color>
    <Color x:Key="M3.OnPrimary">#FFFFFF</Color>
    <Color x:Key="M3.PrimaryContainer">#6FF7F6</Color>
    <Color x:Key="M3.OnPrimaryContainer">#002020</Color>

    <!-- Secondary -->
    <Color x:Key="M3.Secondary">#4A6363</Color>
    <Color x:Key="M3.OnSecondary">#FFFFFF</Color>
    <Color x:Key="M3.SecondaryContainer">#CCE8E7</Color>
    <Color x:Key="M3.OnSecondaryContainer">#051F1F</Color>

    <!-- Tertiary -->
    <Color x:Key="M3.Tertiary">#4B607C</Color>
    <Color x:Key="M3.OnTertiary">#FFFFFF</Color>
    <Color x:Key="M3.TertiaryContainer">#D3E4FF</Color>
    <Color x:Key="M3.OnTertiaryContainer">#041C35</Color>

    <!-- Error -->
    <Color x:Key="M3.Error">#BA1A1A</Color>
    <Color x:Key="M3.OnError">#FFFFFF</Color>
    <Color x:Key="M3.ErrorContainer">#FFDAD6</Color>
    <Color x:Key="M3.OnErrorContainer">#410002</Color>

    <!-- Surface family -->
    <Color x:Key="M3.Surface">#F5FAFA</Color>
    <Color x:Key="M3.SurfaceDim">#D5DBDB</Color>
    <Color x:Key="M3.SurfaceBright">#F5FAFA</Color>
    <Color x:Key="M3.SurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="M3.SurfaceContainerLow">#EFF5F4</Color>
    <Color x:Key="M3.SurfaceContainer">#E9EFEF</Color>
    <Color x:Key="M3.SurfaceContainerHigh">#E4EAEA</Color>
    <Color x:Key="M3.SurfaceContainerHighest">#DEE4E4</Color>
    <Color x:Key="M3.OnSurface">#171D1D</Color>
    <Color x:Key="M3.OnSurfaceVariant">#3F4948</Color>
    <Color x:Key="M3.Outline">#6F7979</Color>
    <Color x:Key="M3.OutlineVariant">#BEC9C8</Color>

    <!-- Inverse -->
    <Color x:Key="M3.InverseSurface">#2B3131</Color>
    <Color x:Key="M3.InverseOnSurface">#ECF2F2</Color>
    <Color x:Key="M3.InversePrimary">#4EDADA</Color>

    <!-- Success (custom semantic) -->
    <Color x:Key="M3.Success">#1B6D2F</Color>
    <Color x:Key="M3.OnSuccess">#FFFFFF</Color>
    <Color x:Key="M3.SuccessContainer">#A3F5A8</Color>
    <Color x:Key="M3.OnSuccessContainer">#002108</Color>

    <!-- Warning (custom semantic) -->
    <Color x:Key="M3.Warning">#7D5700</Color>
    <Color x:Key="M3.OnWarning">#FFFFFF</Color>
    <Color x:Key="M3.WarningContainer">#FFDEA6</Color>
    <Color x:Key="M3.OnWarningContainer">#271900</Color>

    <!-- SolidColorBrush aliases -->
    <SolidColorBrush x:Key="M3.Brush.Primary" Color="{StaticResource M3.Primary}" />
    <SolidColorBrush x:Key="M3.Brush.OnPrimary" Color="{StaticResource M3.OnPrimary}" />
    <SolidColorBrush x:Key="M3.Brush.PrimaryContainer" Color="{StaticResource M3.PrimaryContainer}" />
    <SolidColorBrush x:Key="M3.Brush.OnPrimaryContainer" Color="{StaticResource M3.OnPrimaryContainer}" />

    <SolidColorBrush x:Key="M3.Brush.Secondary" Color="{StaticResource M3.Secondary}" />
    <SolidColorBrush x:Key="M3.Brush.OnSecondary" Color="{StaticResource M3.OnSecondary}" />
    <SolidColorBrush x:Key="M3.Brush.SecondaryContainer" Color="{StaticResource M3.SecondaryContainer}" />
    <SolidColorBrush x:Key="M3.Brush.OnSecondaryContainer" Color="{StaticResource M3.OnSecondaryContainer}" />

    <SolidColorBrush x:Key="M3.Brush.Tertiary" Color="{StaticResource M3.Tertiary}" />
    <SolidColorBrush x:Key="M3.Brush.OnTertiary" Color="{StaticResource M3.OnTertiary}" />
    <SolidColorBrush x:Key="M3.Brush.TertiaryContainer" Color="{StaticResource M3.TertiaryContainer}" />
    <SolidColorBrush x:Key="M3.Brush.OnTertiaryContainer" Color="{StaticResource M3.OnTertiaryContainer}" />

    <SolidColorBrush x:Key="M3.Brush.Error" Color="{StaticResource M3.Error}" />
    <SolidColorBrush x:Key="M3.Brush.OnError" Color="{StaticResource M3.OnError}" />
    <SolidColorBrush x:Key="M3.Brush.ErrorContainer" Color="{StaticResource M3.ErrorContainer}" />
    <SolidColorBrush x:Key="M3.Brush.OnErrorContainer" Color="{StaticResource M3.OnErrorContainer}" />

    <SolidColorBrush x:Key="M3.Brush.Surface" Color="{StaticResource M3.Surface}" />
    <SolidColorBrush x:Key="M3.Brush.SurfaceDim" Color="{StaticResource M3.SurfaceDim}" />
    <SolidColorBrush x:Key="M3.Brush.SurfaceContainerLowest" Color="{StaticResource M3.SurfaceContainerLowest}" />
    <SolidColorBrush x:Key="M3.Brush.SurfaceContainerLow" Color="{StaticResource M3.SurfaceContainerLow}" />
    <SolidColorBrush x:Key="M3.Brush.SurfaceContainer" Color="{StaticResource M3.SurfaceContainer}" />
    <SolidColorBrush x:Key="M3.Brush.SurfaceContainerHigh" Color="{StaticResource M3.SurfaceContainerHigh}" />
    <SolidColorBrush x:Key="M3.Brush.SurfaceContainerHighest" Color="{StaticResource M3.SurfaceContainerHighest}" />
    <SolidColorBrush x:Key="M3.Brush.OnSurface" Color="{StaticResource M3.OnSurface}" />
    <SolidColorBrush x:Key="M3.Brush.OnSurfaceVariant" Color="{StaticResource M3.OnSurfaceVariant}" />
    <SolidColorBrush x:Key="M3.Brush.Outline" Color="{StaticResource M3.Outline}" />
    <SolidColorBrush x:Key="M3.Brush.OutlineVariant" Color="{StaticResource M3.OutlineVariant}" />

    <SolidColorBrush x:Key="M3.Brush.InverseSurface" Color="{StaticResource M3.InverseSurface}" />
    <SolidColorBrush x:Key="M3.Brush.InverseOnSurface" Color="{StaticResource M3.InverseOnSurface}" />
    <SolidColorBrush x:Key="M3.Brush.InversePrimary" Color="{StaticResource M3.InversePrimary}" />

    <SolidColorBrush x:Key="M3.Brush.Success" Color="{StaticResource M3.Success}" />
    <SolidColorBrush x:Key="M3.Brush.OnSuccess" Color="{StaticResource M3.OnSuccess}" />
    <SolidColorBrush x:Key="M3.Brush.SuccessContainer" Color="{StaticResource M3.SuccessContainer}" />
    <SolidColorBrush x:Key="M3.Brush.OnSuccessContainer" Color="{StaticResource M3.OnSuccessContainer}" />

    <SolidColorBrush x:Key="M3.Brush.Warning" Color="{StaticResource M3.Warning}" />
    <SolidColorBrush x:Key="M3.Brush.OnWarning" Color="{StaticResource M3.OnWarning}" />
    <SolidColorBrush x:Key="M3.Brush.WarningContainer" Color="{StaticResource M3.WarningContainer}" />
    <SolidColorBrush x:Key="M3.Brush.OnWarningContainer" Color="{StaticResource M3.OnWarningContainer}" />

    <!-- Shape scale -->
    <CornerRadius x:Key="M3.Shape.None">0</CornerRadius>
    <CornerRadius x:Key="M3.Shape.ExtraSmall">4</CornerRadius>
    <CornerRadius x:Key="M3.Shape.Small">8</CornerRadius>
    <CornerRadius x:Key="M3.Shape.Medium">12</CornerRadius>
    <CornerRadius x:Key="M3.Shape.Large">16</CornerRadius>
    <CornerRadius x:Key="M3.Shape.ExtraLarge">28</CornerRadius>

</ResourceDictionary>
