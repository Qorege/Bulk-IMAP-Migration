<mah:MetroWindow x:Class="IMAPMigrator.WPF.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 mc:Ignorable="d"
                 Title="About Bulk IMAP Migration Suite" Height="380" Width="520"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Icon & Title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="EmailSyncOutline" Width="48" Height="48" Foreground="#0284c7" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Bulk IMAP Migration Suite" FontSize="18" FontWeight="Bold" Foreground="#0f172a" HorizontalAlignment="Center"/>
            <TextBlock Text="WPF MVVM Edition v2.0 · Direct Streaming Engine" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Card Content -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="16,14" Background="White" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="An enterprise-grade, memory-efficient IMAP-to-IMAP mailbox migration and synchronization utility."
                           FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="18"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="#16a34a" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Zero-Downtime Safe · Source Read-Only (EXAMINE mode)" FontSize="11" Foreground="#475569"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="DatabaseCheckOutline" Width="16" Height="16" Foreground="#0284c7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Persistent Journal-based True Deduplication" FontSize="11" Foreground="#475569"/>
                </StackPanel>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,4,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Github" Width="16" Height="16" Foreground="#0f172a" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Repository:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                    <TextBlock>
                        <Hyperlink Click="Hyperlink_Click" NavigateUri="https://github.com/Qorege/Bulk-IMAP-Migration" Foreground="#0284c7">
                            https://github.com/Qorege/Bulk-IMAP-Migration
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Close Button -->
        <Button Grid.Row="2" Click="CloseButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                Height="34" Width="100" HorizontalAlignment="Right" Background="#0284c7" BorderBrush="#0284c7">
            <TextBlock Text="Close" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
        </Button>
    </Grid>
</mah:MetroWindow>
