<mah:MetroWindow x:Class="IMAPMigrator.WPF.Views.AccountEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:ImapSyncWin="clr-namespace:ImapSyncWin"
                 mc:Ignorable="d"
                 Title="Edit Queued Account" Height="680" Width="920"
                 WindowStartupLocation="CenterOwner"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 Background="#F8FAFC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top Credential Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Folder Mappings Section -->
            <RowDefinition Height="*"/>
            <!-- Bottom Save / Cancel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP CREDENTIALS CARDS (1:1 Side by Side) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SOURCE CARD -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="10" Padding="14,12" Background="White">
                <StackPanel>
                    <TextBlock Text="SOURCE MAILBOX" FontSize="11" FontWeight="Bold" Foreground="#0284c7" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HOST" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding SourceHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PORT" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding SourcePort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SECURITY" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <ComboBox SelectedItem="{Binding SourceSecurity}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="34" FontSize="12">
                                <ComboBox.Items>
                                    <x:Static Member="ImapSyncWin:SecurityType.SslTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.StartTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.Plain"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="USER / EMAIL" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding SourceUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding SourcePass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding SourceStatusText}" FontSize="11" Foreground="#64748b" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Command="{Binding ConnectSourceCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="12,0" DockPanel.Dock="Right">
                            <TextBlock Text="Load Folders" FontSize="11"/>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- DESTINATION CARD -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="10" Padding="14,12" Background="White">
                <StackPanel>
                    <TextBlock Text="DESTINATION MAILBOX" FontSize="11" FontWeight="Bold" Foreground="#16a34a" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HOST" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding DestHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PORT" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding DestPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SECURITY" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <ComboBox SelectedItem="{Binding DestSecurity}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="34" FontSize="12">
                                <ComboBox.Items>
                                    <x:Static Member="ImapSyncWin:SecurityType.SslTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.StartTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.Plain"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="USER / EMAIL" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding DestUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                            <TextBox Text="{Binding DestPass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="34" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding DestStatusText}" FontSize="11" Foreground="#64748b" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Command="{Binding ConnectDestCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Padding="12,0" DockPanel.Dock="Right">
                            <TextBlock Text="Load Folders" FontSize="11"/>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- FOLDER MAPPINGS CARD -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="14,10" Background="White" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="FOLDER MAPPINGS" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Command="{Binding SelectAllFoldersCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="28" Padding="6,0" Margin="0,0,4,0">
                            <TextBlock Text="Select All" FontSize="11" Foreground="#0284c7"/>
                        </Button>
                        <Button Command="{Binding DeselectAllFoldersCommand}" Style="{StaticResource MaterialDesignToolButton}" Height="28" Padding="6,0">
                            <TextBlock Text="Deselect All" FontSize="11" Foreground="#64748b"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FolderMappings}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          HeadersVisibility="Column" BorderThickness="0" Background="White"
                          FontSize="12" RowHeight="36">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Checkbox -->
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>

                        <!-- Source Folder -->
                        <DataGridTextColumn Header="SOURCE FOLDER" Binding="{Binding SourceFolder}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>

                        <!-- Messages -->
                        <DataGridTextColumn Header="MESSAGES" Binding="{Binding MessageCount}" Width="100" IsReadOnly="True"/>

                        <!-- Arrow -->
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="➔" HorizontalAlignment="Center" Foreground="#0284c7" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Destination Folder -->
                        <DataGridTemplateColumn Header="DESTINATION FOLDER" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableDestinationFolders}"
                                              SelectedItem="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Style="{StaticResource MaterialDesignComboBox}" Height="30" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- BOTTOM BUTTONS -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36" Padding="18,0" DockPanel.Dock="Right" Margin="8,0,0,0">
                <TextBlock Text="Cancel" FontSize="12"/>
            </Button>

            <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="36" Padding="20,0" Background="#0284c7" BorderBrush="#0284c7" DockPanel.Dock="Right">
                <TextBlock Text="Save Changes" FontSize="12" FontWeight="Bold" Foreground="White"/>
            </Button>
        </DockPanel>
    </Grid>
</mah:MetroWindow>
