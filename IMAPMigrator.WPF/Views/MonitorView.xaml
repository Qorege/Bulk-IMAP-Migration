<UserControl x:Class="IMAPMigrator.WPF.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1050"
             Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <!-- 0: Top Overall Progress Card -->
                <RowDefinition Height="Auto"/>
                <!-- 1: LiveCharts2 Analytics (Donut & Speed) -->
                <RowDefinition Height="240"/>
                <!-- 2: Folder Progress Table -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Live Dark Activity Log -->
                <RowDefinition Height="260"/>
                <!-- 4: Bottom Action Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP PROGRESS CARD -->
            <materialDesign:Card Grid.Row="0" UniformCornerRadius="10" Padding="18,14" Background="White" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                            <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                            <TextBlock Text="{Binding PairDescription}" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border DockPanel.Dock="Right" CornerRadius="12" Background="#E0F2FE" Padding="12,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#0284c7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#0369a1"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="1" Value="{Binding OverallProgressPercentage, Mode=OneWay}" Maximum="100" Height="10"
                                 materialDesign:TransitionAssist.DisableTransitions="True"
                                 Foreground="#0284c7" Background="#E2E8F0" Margin="0,4,0,8"/>

                    <!-- Details Row -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <TextBlock Text="{Binding ProcessedSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Moved: " FontSize="12" Foreground="#64748b"/>
                            <TextBlock Text="{Binding MovedCount}" FontSize="12" FontWeight="Bold" Foreground="#16a34a" Margin="0,0,14,0"/>

                            <TextBlock Text="Skipped: " FontSize="12" Foreground="#64748b"/>
                            <TextBlock Text="{Binding SkippedCount}" FontSize="12" FontWeight="Bold" Foreground="#0284c7" Margin="0,0,14,0"/>

                            <TextBlock Text="Errors: " FontSize="12" Foreground="#64748b"/>
                            <TextBlock Text="{Binding ErrorsCount}" FontSize="12" FontWeight="Bold" Foreground="#ef4444"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </materialDesign:Card>

            <!-- CHARTS ROW (1:1 Equal Width Side by Side) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Donut Breakdown Chart -->
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="10" Padding="14,10" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock Text="MESSAGE BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="#64748b" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Ellipse Width="8" Height="8" Fill="#0284c7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Moved" FontSize="10" Foreground="#64748b" Margin="0,0,8,0"/>
                                <Ellipse Width="8" Height="8" Fill="#14b8a6" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Skipped" FontSize="10" Foreground="#64748b" Margin="0,0,8,0"/>
                                <Ellipse Width="8" Height="8" Fill="#ef4444" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Errors" FontSize="10" Foreground="#64748b"/>
                            </StackPanel>
                        </DockPanel>

                        <lvc:PieChart Grid.Row="1" Series="{Binding PieSeries}" InitialRotation="-90"
                                      MaxAngle="360" LegendPosition="Hidden" />
                    </Grid>
                </materialDesign:Card>

                <!-- Right: Throughput Speed Line Chart -->
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="10" Padding="14,10" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock Text="THROUGHPUT (EMAILS / SEC)" FontSize="11" FontWeight="Bold" Foreground="#64748b" DockPanel.Dock="Left"/>
                            <materialDesign:PackIcon Kind="Speedometer" Width="16" Height="16" Foreground="#0284c7" DockPanel.Dock="Right"/>
                        </DockPanel>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding SpeedSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            LegendPosition="Hidden" TooltipPosition="Top" />
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- FOLDER PROGRESS TABLE CARD -->
            <materialDesign:Card Grid.Row="2" UniformCornerRadius="10" Padding="0" Background="White" Margin="0,0,0,12" MaxHeight="220">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                        <TextBlock Text="FOLDER PROGRESS" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FolderProgressList}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserResizeRows="False" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column" BorderThickness="0" Background="White"
                              FontSize="12" RowHeight="34">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FOLDER" Binding="{Binding FolderName}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110"/>
                            <DataGridTemplateColumn Header="PROGRESS" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="8"
                                                         Foreground="#0284c7" Background="#E2E8F0"
                                                         materialDesign:TransitionAssist.DisableTransitions="True"/>
                                            <TextBlock Text="{Binding SummaryText}" FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1e293b"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MOVED" Binding="{Binding Moved}" Width="80"/>
                            <DataGridTextColumn Header="SKIPPED" Binding="{Binding Skipped}" Width="80"/>
                            <DataGridTextColumn Header="ERRORS" Binding="{Binding Errors}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- LIVE ACTIVITY LOG CARD (Dark Navy/Slate Terminal) -->
            <materialDesign:Card Grid.Row="3" UniformCornerRadius="10" Padding="0" Background="#0F172A" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#1E293B" Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="#334155">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <materialDesign:PackIcon Kind="ConsoleLine" Width="16" Height="16" Foreground="#38bdf8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Live Activity Log" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                                <Button Command="{Binding OpenLogFileCommand}" Style="{StaticResource MaterialDesignToolButton}"
                                        Height="26" Padding="8,0" Margin="0,0,4,0" ToolTip="Open persistent TSV journal">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" Foreground="#94a3b8" Margin="0,0,4,0"/>
                                        <TextBlock Text="Open TSV Journal" FontSize="11" Foreground="#94a3b8"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ClearLogCommand}" Style="{StaticResource MaterialDesignToolButton}"
                                        Height="26" Padding="8,0" ToolTip="Clear visible log">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Foreground="#94a3b8" Margin="0,0,4,0"/>
                                        <TextBlock Text="Clear" FontSize="11" Foreground="#94a3b8"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Terminal Scroll Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,6">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding FormattedTime, StringFormat='[{0}] '}" FontFamily="Consolas" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Level, StringFormat='[{0}] '}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{Binding LevelBrush}"/>
                                        <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- ACTION BAR & SAFETY -->
            <materialDesign:Card Grid.Row="4" UniformCornerRadius="10" Padding="14,10" Background="White">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="ShieldCheck" Width="18" Height="18" Foreground="#0284c7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Safe to Pause or Resume. Transfer is journaled. Re-running continues from the same place without duplicates."
                                   FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <Button Command="{Binding TogglePauseCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="34" Padding="14,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pause" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Pause / Resume" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding StopCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="34" Padding="16,0" Background="#ef4444" BorderBrush="#ef4444">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="15" Height="15" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="Stop" FontSize="12" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
