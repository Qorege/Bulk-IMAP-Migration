<UserControl x:Class="IMAPMigrator.WPF.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IMAPMigrator.WPF.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:StatusToColorConverter x:Key="StatusColor" />
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ OVERALL PROGRESS ═══ -->
        <TextBlock Grid.Row="0" Text="Overall Progress"
                   Style="{StaticResource M3.Text.TitleMedium}"
                   Foreground="{StaticResource M3.Brush.OnSurface}" />

        <Border Grid.Row="2" Style="{StaticResource M3.Card.Outlined}">
            <StackPanel>
                <!-- Progress bar -->
                <Grid Margin="0,0,0,12">
                    <ProgressBar Style="{StaticResource M3.ProgressBar}"
                                 Value="{Binding OverallPercentage}"
                                 Maximum="100"
                                 Height="8" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource M3.Text.TitleLarge}"
                               Foreground="{StaticResource M3.Brush.Primary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1}%">
                                <Binding Path="OverallPercentage" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeRemaining}"
                               Style="{StaticResource M3.Text.BodyMedium}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Stats grid -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total" Style="{StaticResource M3.Text.LabelSmall}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding TotalMessages}"
                                   Style="{StaticResource M3.Text.TitleMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurface}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Processed" Style="{StaticResource M3.Text.LabelSmall}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding ProcessedMessages}"
                                   Style="{StaticResource M3.Text.TitleMedium}"
                                   Foreground="{StaticResource M3.Brush.Primary}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Moved" Style="{StaticResource M3.Text.LabelSmall}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding MovedMessages}"
                                   Style="{StaticResource M3.Text.TitleMedium}"
                                   Foreground="{StaticResource M3.Brush.Success}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Skipped" Style="{StaticResource M3.Text.LabelSmall}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding SkippedMessages}"
                                   Style="{StaticResource M3.Text.TitleMedium}"
                                   Foreground="{StaticResource M3.Brush.Warning}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Errors" Style="{StaticResource M3.Text.LabelSmall}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
                        <TextBlock Text="{Binding ErrorMessages}"
                                   Style="{StaticResource M3.Text.TitleMedium}"
                                   Foreground="{StaticResource M3.Brush.Error}" />
                    </StackPanel>
                </Grid>

                <!-- Speed & action -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentAction}"
                               Style="{StaticResource M3.Text.BodySmall}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource M3.Text.BodySmall}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} msg/s">
                                <Binding Path="MessagesPerSecond" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ FOLDER PROGRESS ═══ -->
        <Border Grid.Row="4" Style="{StaticResource M3.Card.Filled}">
            <StackPanel>
                <TextBlock Text="Current Folder"
                           Style="{StaticResource M3.Text.LabelMedium}"
                           Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentFolder, FallbackValue='—'}"
                           Style="{StaticResource M3.Text.TitleSmall}"
                           Foreground="{StaticResource M3.Brush.OnSurface}" />
                <ProgressBar Style="{StaticResource M3.ProgressBar}"
                             Value="{Binding FolderPercentage}"
                             Maximum="100"
                             Margin="0,8,0,4" />
                <TextBlock Text="{Binding FolderStatus, FallbackValue=''}"
                           Style="{StaticResource M3.Text.BodySmall}"
                           Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
            </StackPanel>
        </Border>

        <!-- ═══ CONTROLS ═══ -->
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button Content="Pause"
                    Style="{StaticResource M3.Button.Outlined}"
                    Command="{Binding PauseCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                    Margin="0,0,8,0" />
            <Button Content="Resume"
                    Style="{StaticResource M3.Button.FilledTonal}"
                    Command="{Binding ResumeCommand}"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}"
                    Margin="0,0,8,0" />
            <Button Content="Stop"
                    Style="{StaticResource M3.Button.Error}"
                    Command="{Binding StopCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                    Margin="0,0,16,0" />
            <Button Content="Clear Log"
                    Style="{StaticResource M3.Button.Text}"
                    Command="{Binding ClearLogCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Clear Journal"
                    Style="{StaticResource M3.Button.Text}"
                    Command="{Binding ClearJournalCommand}" />
        </StackPanel>

        <!-- ═══ LOG ═══ -->
        <TextBlock Grid.Row="7" Text="Activity Log"
                   Style="{StaticResource M3.Text.LabelMedium}"
                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <Border Grid.Row="8" Style="{StaticResource M3.Card.Outlined}" Padding="0">
            <ListBox Style="{StaticResource M3.ListBox}"
                     ItemsSource="{Binding LogEntries}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding TimeString}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Level}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{Binding Level, Converter={StaticResource StatusColor}}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Message}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource M3.Brush.OnSurface}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ═══ BOTTOM STATUS ═══ -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource M3.Text.LabelSmall}"
                       Foreground="{StaticResource M3.Brush.OnSurfaceVariant}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}Log entries: {0}">
                        <Binding Path="LogEntries.Count" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
