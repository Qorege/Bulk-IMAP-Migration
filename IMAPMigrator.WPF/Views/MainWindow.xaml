<Window x:Class="IMAPMigrator.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IMAPMigrator.WPF.ViewModels"
        xmlns:views="clr-namespace:IMAPMigrator.WPF.Views"
        Title="IMAP Migrator"
        Width="960" Height="720"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource M3.Window}"
        Icon="/app.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ TOP APP BAR ═══ -->
        <Border Grid.Row="0"
                Background="{StaticResource M3.Brush.SurfaceContainer}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/icon.png" Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="IMAP Migrator"
                               Style="{StaticResource M3.Text.TitleLarge}"
                               Foreground="{StaticResource M3.Brush.OnSurface}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           Style="{StaticResource M3.Text.BodyMedium}"
                           Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource M3.TabControl}"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0">

            <TabItem Style="{StaticResource M3.TabItem}" Header="Single Migration">
                <views:SingleMigrationView DataContext="{Binding SingleMigration}" />
            </TabItem>

            <TabItem Style="{StaticResource M3.TabItem}" Header="Bulk Queue">
                <views:QueueView DataContext="{Binding Queue}" />
            </TabItem>

            <TabItem Style="{StaticResource M3.TabItem}" Header="Monitor">
                <views:MonitorView DataContext="{Binding Monitor}" />
            </TabItem>

            <TabItem Style="{StaticResource M3.TabItem}" Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <!-- ═══ BOTTOM STATUS ═══ -->
        <Border Grid.Row="2"
                Background="{StaticResource M3.Brush.SurfaceContainerLow}"
                Padding="24,8"
                BorderBrush="{StaticResource M3.Brush.OutlineVariant}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="Bulk IMAP Migration Tool — github.com/Qorege/Bulk-IMAP-Migration"
                       Style="{StaticResource M3.Text.LabelSmall}"
                       Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" />
        </Border>
    </Grid>
</Window>
