<UserControl x:Class="IMAPMigrator.WPF.Views.SingleMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IMAPMigrator.WPF.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
        <StackPanel MaxWidth="800">

            <!-- ═══ SOURCE SERVER ═══ -->
            <TextBlock Text="Source Server"
                       Style="{StaticResource M3.Text.TitleMedium}"
                       Foreground="{StaticResource M3.Brush.OnSurface}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource M3.Card.Outlined}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Provider preset -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Provider" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource M3.ComboBox}"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedSourcePreset}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <!-- Host -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Host" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding SourceHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding SourcePort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- User -->
                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Email / Username" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding SourceUser, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Password" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding SourcePassword, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Security -->
                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Security" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource M3.ComboBox}"
                                  SelectedItem="{Binding SourceSecurity}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="sys:String">
                                    <sys:String>SslTls</sys:String>
                                    <sys:String>StartTls</sys:String>
                                    <sys:String>Plain</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                    </StackPanel>

                    <!-- Test button & result -->
                    <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Button Content="Test Connection"
                                Style="{StaticResource M3.Button.Outlined}"
                                Command="{Binding TestSourceCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                                Margin="0,0,16,0" />
                        <TextBlock Text="{Binding SourceTestResult}"
                                   Style="{StaticResource M3.Text.BodyMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ DESTINATION SERVER ═══ -->
            <TextBlock Text="Destination Server"
                       Style="{StaticResource M3.Text.TitleMedium}"
                       Foreground="{StaticResource M3.Brush.OnSurface}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource M3.Card.Outlined}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                        <TextBlock Text="Provider" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource M3.ComboBox}"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedDestPreset}"
                                  DisplayMemberPath="Name" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Host" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding DestHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Port" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding DestPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Text="Email / Username" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding DestUser, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Text="Password" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                                 Text="{Binding DestPassword, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0">
                        <TextBlock Text="Security" Style="{StaticResource M3.Text.LabelMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource M3.ComboBox}"
                                  SelectedItem="{Binding DestSecurity}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="sys:String">
                                    <sys:String>SslTls</sys:String>
                                    <sys:String>StartTls</sys:String>
                                    <sys:String>Plain</sys:String>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="8" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Button Content="Test Connection"
                                Style="{StaticResource M3.Button.Outlined}"
                                Command="{Binding TestDestCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"
                                Margin="0,0,16,0" />
                        <TextBlock Text="{Binding DestTestResult}"
                                   Style="{StaticResource M3.Text.BodyMedium}"
                                   Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ FOLDER MAPPINGS ═══ -->
            <TextBlock Text="Folder Mappings"
                       Style="{StaticResource M3.Text.TitleMedium}"
                       Foreground="{StaticResource M3.Brush.OnSurface}"
                       Margin="0,0,0,12" />

            <Border Style="{StaticResource M3.Card.Outlined}" Margin="0,0,0,16">
                <StackPanel>
                    <Button Content="Scan Source Folders"
                            Style="{StaticResource M3.Button.FilledTonal}"
                            Command="{Binding ScanFoldersCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12" />

                    <DataGrid Style="{StaticResource M3.DataGrid}"
                              ItemsSource="{Binding FolderMappings}"
                              MaxHeight="250"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Selected" Binding="{Binding Selected}" Width="70" />
                            <DataGridTextColumn Header="Source Folder" Binding="{Binding SourceFolder}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Destination Folder" Binding="{Binding DestFolder}" Width="*" />
                            <DataGridTextColumn Header="Messages" Binding="{Binding MessageCount}" Width="90" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ═══ ACTIONS ═══ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Start Migration"
                        Style="{StaticResource M3.Button.Filled}"
                        Command="{Binding StartMigrationCommand}"
                        IsEnabled="{Binding IsMigrating, Converter={StaticResource InverseBool}}"
                        Margin="0,0,16,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource M3.Text.BodyMedium}"
                           Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
