<UserControl x:Class="IMAPMigrator.WPF.Views.SingleMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:ImapSyncWin="clr-namespace:ImapSyncWin"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="#F8FAFC">

    <Grid Margin="16,8,16,12">
        <Grid.RowDefinitions>
            <!-- Top Credentials Cards (Auto) -->
            <RowDefinition Height="Auto"/>
            <!-- Folders Mapping Area (Star) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Controls Bar (Auto) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP CREDENTIALS CARDS (1:1 Side by Side) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- SOURCE CARD -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="10" Padding="16,12,16,14" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Status Pill -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="EmailArrowRightOutline" Width="20" Height="20" Foreground="#0284c7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Source Mailbox (Read-Only)" FontWeight="Bold" FontSize="14" Foreground="#0f172a" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="12" Padding="10,3">
                            <TextBlock Text="{Binding SourceStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </Grid>

                    <!-- Service Provider -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,8">
                        <TextBlock Text="EMAIL SERVICE PROVIDER" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedSourcePreset}" DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="12" Height="36"/>
                    </StackPanel>

                    <!-- Server, Port, Security -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IMAP SERVER / HOST" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding SourceHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PORT" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding SourcePort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SECURITY" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <ComboBox SelectedItem="{Binding SourceSecurity}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="36" FontSize="12">
                                <ComboBox.Items>
                                    <x:Static Member="ImapSyncWin:SecurityType.SslTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.StartTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.Plain"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Username & Password -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="USER NAME / EMAIL ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding SourceUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PASSWORD / APP PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <Grid>
                                <TextBox Text="{Binding SourcePass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"
                                         Padding="8,0,32,0"/>
                                <Button Command="{Binding ToggleSourcePassCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" Foreground="#64748b"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Checklist -->
                    <TextBlock Grid.Row="4" Text="✓ Server responds    ✓ SSL/TLS    ✓ Sign-in    ✓ Folders"
                               FontSize="11" Foreground="#94a3b8" Margin="0,0,0,10"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding TestSourceCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Flash" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Test Connection" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ConnectSourceCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="32" Padding="16,0" Background="#0284c7" BorderBrush="#0284c7">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Connect" FontSize="12" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- ARROW IN CENTER -->
            <TextBlock Grid.Column="1" Text="➔" FontSize="20" FontWeight="Bold" Foreground="#0284c7"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- DESTINATION CARD -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="10" Padding="16,12,16,14" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Status Pill -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="EmailCheckOutline" Width="20" Height="20" Foreground="#0284c7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Destination Mailbox" FontWeight="Bold" FontSize="14" Foreground="#0f172a" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="12" Padding="10,3">
                            <TextBlock Text="{Binding DestStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </Grid>

                    <!-- Service Provider -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,8">
                        <TextBlock Text="EMAIL SERVICE PROVIDER" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedDestPreset}" DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="12" Height="36"/>
                    </StackPanel>

                    <!-- Server, Port, Security -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IMAP SERVER / HOST" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DestHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PORT" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DestPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SECURITY" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <ComboBox SelectedItem="{Binding DestSecurity}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="36" FontSize="12">
                                <ComboBox.Items>
                                    <x:Static Member="ImapSyncWin:SecurityType.SslTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.StartTls"/>
                                    <x:Static Member="ImapSyncWin:SecurityType.Plain"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Username & Password -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="USER NAME / EMAIL ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DestUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PASSWORD / APP PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="0,0,0,2"/>
                            <Grid>
                                <TextBox Text="{Binding DestPass, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Height="36" FontSize="12"
                                         Padding="8,0,32,0"/>
                                <Button Command="{Binding ToggleDestPassCommand}" Style="{StaticResource MaterialDesignToolButton}" Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                                    <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16" Foreground="#64748b"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Checklist -->
                    <TextBlock Grid.Row="4" Text="✓ Server responds    ✓ SSL/TLS    ✓ Sign-in    ✓ Folders"
                               FontSize="11" Foreground="#94a3b8" Margin="0,0,0,10"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding TestDestCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Flash" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Test Connection" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ConnectDestCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="32" Padding="16,0" Background="#0284c7" BorderBrush="#0284c7">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Connect" FontSize="12" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- FOLDERS TO MIGRATE & DESTINATION MAPPING (1:1 Ratio with Rounded Cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Folders to Migrate Card -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="10" Padding="14,10" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Folders to Migrate" FontWeight="Bold" FontSize="13" Foreground="#0f172a" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding SelectAllCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="26" Padding="6,0" FontSize="11" Content="Select all"/>
                            <TextBlock Text="·" Foreground="#94a3b8" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Command="{Binding ClearAllCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="26" Padding="6,0" FontSize="11" Content="Clear all"/>
                        </StackPanel>
                    </DockPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding FolderMappings}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SourceFolder}" FontSize="12" Foreground="#0f172a" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding MessageCount, StringFormat='{}{0:N0} msgs'}" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </materialDesign:Card>

            <!-- RIGHT: Destination Folder Mapping Card -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="10" Padding="14,10" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Destination Folder Mapping" FontWeight="Bold" FontSize="13" Foreground="#0f172a" VerticalAlignment="Center"/>
                        <Button Command="{Binding AddCustomDestFolderCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Right" Height="26" Padding="6,0" FontSize="11" Content="+ Add new target folder"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FolderMappings}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="White" BorderThickness="0" RowHeight="32">
                        <DataGrid.Columns>
                            <!-- Source Folder -->
                            <DataGridTextColumn Header="Source Folder" Binding="{Binding SourceFolder}" IsReadOnly="True" Width="2*"/>

                            <!-- Arrow -->
                            <DataGridTextColumn Header="➔" Binding="{Binding SourceFolder, Converter={x:Null}}" IsReadOnly="True" Width="36"/>

                            <!-- Destination Dropdown Mapping -->
                            <DataGridTemplateColumn Header="Destination Folder (Dropdown)" Width="3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableDestinationFolders}" SelectedItem="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource MaterialDesignComboBox}" FontSize="12" Height="28"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- BOTTOM CONTROLS BAR -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="10" Padding="16,10" Background="White">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="Period:" FontWeight="Bold" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedItem="{Binding TimePeriod}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Height="34" Width="135" FontSize="12">
                        <ComboBox.Items>
                            <x:Static Member="ImapSyncWin:TimePeriodOption.AllMessages"/>
                            <x:Static Member="ImapSyncWin:TimePeriodOption.Last6Months"/>
                            <x:Static Member="ImapSyncWin:TimePeriodOption.LastYear"/>
                            <x:Static Member="ImapSyncWin:TimePeriodOption.CustomDates"/>
                        </ComboBox.Items>
                    </ComboBox>

                    <!-- True Deduplication Badge -->
                    <Border Background="#F0FDF4" CornerRadius="12" Padding="12,5" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14" Foreground="#16a34a" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="True Deduplication Active" FontSize="11" FontWeight="Bold" Foreground="#15803d"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding SelectionSummary}" FontSize="12" Foreground="#64748b" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Button Command="{Binding AddToQueueCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Padding="14,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add to Queue" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StartMigrationCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="34" Padding="18,0" Background="#0284c7" BorderBrush="#0284c7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Start Migration ➔" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
