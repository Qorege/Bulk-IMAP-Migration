<UserControl x:Class="IMAPMigrator.WPF.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IMAPMigrator.WPF.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Migration Queue"
                       Style="{StaticResource M3.Text.TitleMedium}"
                       Foreground="{StaticResource M3.Brush.OnSurface}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Import CSV"
                        Style="{StaticResource M3.Button.Outlined}"
                        Command="{Binding ImportCsvCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                        Margin="0,0,8,0" />
                <Button Content="Export CSV"
                        Style="{StaticResource M3.Button.Text}"
                        Command="{Binding ExportCsvCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Sample CSV"
                        Style="{StaticResource M3.Button.Text}"
                        Command="{Binding ExportSampleCsvCommand}" />
            </StackPanel>
        </Grid>

        <!-- ═══ ACCOUNT LIST ═══ -->
        <Border Grid.Row="2" Style="{StaticResource M3.Card.Outlined}" Padding="0">
            <DataGrid Style="{StaticResource M3.DataGrid}"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source Host" Binding="{Binding SourceHost}" Width="140" />
                    <DataGridTextColumn Header="Source User" Binding="{Binding SourceUser}" Width="*" />
                    <DataGridTextColumn Header="Dest Host" Binding="{Binding DestHost}" Width="140" />
                    <DataGridTextColumn Header="Dest User" Binding="{Binding DestUser}" Width="*" />
                    <DataGridTextColumn Header="Folders" Binding="{Binding Folders}" Width="150" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ ACCOUNT EDIT BUTTONS ═══ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Add Account"
                    Style="{StaticResource M3.Button.FilledTonal}"
                    Command="{Binding AddAccountCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                    Margin="0,0,8,0" />
            <Button Content="Remove Selected"
                    Style="{StaticResource M3.Button.Text}"
                    Command="{Binding RemoveAccountCommand}"
                    Foreground="{StaticResource M3.Brush.Error}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
        </StackPanel>

        <!-- ═══ SELECTED ACCOUNT DETAILS ═══ -->
        <Border Grid.Row="6"
                Style="{StaticResource M3.Card.Outlined}"
                Visibility="{Binding SelectedAccount, Converter={StaticResource BoolVis}}"
                DataContext="{Binding SelectedAccount}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Source Email" Style="{StaticResource M3.Text.LabelMedium}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                             Text="{Binding SourceUser, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Source Password" Style="{StaticResource M3.Text.LabelMedium}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                             Text="{Binding SourcePassword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Dest Email" Style="{StaticResource M3.Text.LabelMedium}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                             Text="{Binding DestUser, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Dest Password" Style="{StaticResource M3.Text.LabelMedium}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                             Text="{Binding DestPassword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                    <TextBlock Text="Folders (comma-separated)" Style="{StaticResource M3.Text.LabelMedium}"
                               Foreground="{StaticResource M3.Brush.OnSurfaceVariant}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource M3.TextBox.Outlined}"
                             Text="{Binding Folders, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ QUEUE CONTROLS ═══ -->
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <Button Content="Start Queue"
                    Style="{StaticResource M3.Button.Filled}"
                    Command="{Binding StartQueueCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                    Margin="0,0,8,0" />
            <Button Content="Pause"
                    Style="{StaticResource M3.Button.Outlined}"
                    Command="{Binding PauseQueueCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                    Margin="0,0,8,0" />
            <Button Content="Resume"
                    Style="{StaticResource M3.Button.FilledTonal}"
                    Command="{Binding ResumeQueueCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                    Margin="0,0,8,0" />
            <Button Content="Stop"
                    Style="{StaticResource M3.Button.Error}"
                    Command="{Binding StopQueueCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"
                    Margin="0,0,16,0" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource M3.Text.BodyMedium}"
                       Foreground="{StaticResource M3.Brush.OnSurfaceVariant}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
